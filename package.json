{
  "name": "coverflow-monorepo",
  "private": true,
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev:api": "npm run dev --workspace=@coverflow/api",
    "dev:web": "npm run dev --workspace=@coverflow/web",
    "build": "npm run build --workspaces --if-present",
    "test": "npm run test --workspace=@coverflow/domain",
    "db:push": "npm run db:push --workspace=@coverflow/api",
    "db:seed": "npm run db:seed --workspace=@coverflow/api"
  }
}
